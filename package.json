{
  "name": "anvia-documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm docs:dev",
    "docs:dev": "node scripts/docs-dev.mjs",
    "docs:dev:current": "node scripts/docs-dev-current.mjs",
    "docs:dev:rc": "DOCS_CHANNEL=rc vitepress dev --port 5174 --strictPort",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:build:current": "node scripts/docs-build.mjs --current-only",
    "docs:build:rc": "DOCS_CHANNEL=rc vitepress build",
    "docs:preview": "pnpm docs:preview:current",
    "docs:preview:current": "DOCS_CHANNEL=current vitepress preview",
    "docs:preview:rc": "DOCS_CHANNEL=rc vitepress preview",
    "docs:deploy": "pnpm docs:build && wrangler deploy",
    "docs:deploy:dry-run": "pnpm docs:build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "lucide-static": "^1.31.0",
    "vitepress": "^1.6.4",
    "wrangler": "^4.120.0"
  }
}
